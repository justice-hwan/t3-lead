#!/usr/bin/env python3
"""t3-lead state CLI: lead registration, request ledger, lessons, summary.

  t3lead init                          register this thread (T3CODE_THREAD_ID) as the lead
  t3lead task add "<request>" [--source S] [--where REMOTE]   record a request, print its ID
  t3lead task move <id> <state> [--note N] [--verifier THREAD] [--where REMOTE]
        states: open working waiting-owner delivered done dropped
        --where: which remote computer runs the lanes (a name from `t3lead remotes`); `--where -` clears it
  t3lead task list [--all]             unfinished requests (default) / all requests
  t3lead task show <id>
  t3lead rule add [--shared] "<rule>"    add a standing user rule; the hook injects every rule into all
                                          verifiers and lanes. --shared: the private shared-rules repository
                                          (owner_rules_dir, all computers); default: this computer only
  t3lead rule list | rm S<n>|L<n> | sync  list rules / remove one / pull and push the shared rules
  t3lead heavy --group G [--label L] [--max-wait S] -- <command ...>
                                          run a command when a slot in heavy group G is free (FIFO across all
                                          sessions on this computer); slots come from heavy_groups in config.json
  t3lead heavy status                     holders and waiters per group
  t3lead backup [--init] [--status]       commit and push state/ (ledger, lessons, this computer's rules, notes) to the
                                          private repository in state_remote; runs on its own after every ledger change
  t3lead learn "<one-line lesson>" [--kind K]
  t3lead lessons [--kind K]
  t3lead status                        ~20-line summary for the lead to read after a restart
  t3lead models                        provider instance / model per role, from config.json (or defaults);
                                       one block per configured remote computer
  t3lead remotes                       remote computers (T3 linked environments) from config.json
  t3lead version                       installed version, the latest release, and newer commits on origin
  t3lead upgrade [--check] [--edge] [--quiet]
                                       move to the latest release tag (fast-forward only) and re-run install.sh;
                                       --edge follows the branch (main) instead of release tags;
                                       --check only lists the new commits; --quiet prints only the install.sh
                                       lines worth reading (warnings, changes)
"""
import json, os, secrets, subprocess, sys, time

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "lib"))
import t3lead_config, t3lead_heavy

try:
    CFG = t3lead_config.load()
except t3lead_config.ConfigError as e:
    print("t3lead config error: %s" % e, file=sys.stderr); sys.exit(2)
ROOT = CFG["home"]
STATE = os.path.join(ROOT, "state")
TASKS = os.path.join(STATE, "tasks")
LESSONS = os.path.join(STATE, "lessons.jsonl")
STATES = ["open", "working", "waiting-owner", "delivered", "done", "dropped"]
OPEN = {"open", "working", "waiting-owner", "delivered"}

now = lambda: time.strftime("%Y-%m-%dT%H:%M:%S")


def die(msg):
    print(msg, file=sys.stderr); sys.exit(2)


def opt(args, name, default=None):
    if name in args:
        i = args.index(name)
        if i + 1 >= len(args): die(f"missing value for {name}")
        v = args[i + 1]; del args[i:i + 2]; return v
    return default


STATE_GITIGNORE = "roles/\nhook.log\nheavy/\n*.tmp\n.backup.lock\nbackup.err\n"


CRED_HINT = ("  If this is an authentication error: git in a T3 session often has a different $HOME and cannot see your\n"
             "  credentials. Point this repository at the existing ones, e.g. (gh login)\n"
             "    git -C {d} config credential.https://github.com.helper '!GH_CONFIG_DIR=<real home>/.config/gh gh auth git-credential'\n"
             "  or (SSH key) git -C {d} config core.sshCommand 'ssh -i <real home>/.ssh/<key>'. Do not create new keys or tokens.")


def auth_hint(text, d):
    t = text.lower()
    if any(k in t for k in ("authentication", "could not read username", "permission denied", "terminal prompts disabled",
                            "403", "could not read from remote")):
        return "\n" + CRED_HINT.format(d=d)
    return ""


def sgit(*args, check=True):
    r = subprocess.run(["git", "-C", STATE, *args], capture_output=True, text=True)
    if check and r.returncode != 0:
        raise RuntimeError("git %s: %s" % (" ".join(args), (r.stderr or r.stdout).strip()))
    return r.stdout.strip()


def backup_ready():
    return bool(CFG["state_remote"]) and os.path.isdir(os.path.join(STATE, ".git"))


def backup_init():
    remote = CFG["state_remote"]
    if not remote: die("set state_remote in config.json to a private git repository URL first")
    os.makedirs(STATE, exist_ok=True)
    if not os.path.isdir(os.path.join(STATE, ".git")):
        sgit("init", "-q", "-b", "main")
    with open(os.path.join(STATE, ".gitignore"), "w") as f: f.write(STATE_GITIGNORE)
    for k in ("user.name", "user.email"):  # same identity as the t3-lead checkout, if it has one
        v = git("config", k, check=False)
        if v and not sgit("config", "--local", k, check=False): sgit("config", "--local", k, v)
    if sgit("remote", check=False): sgit("remote", "set-url", "origin", remote)
    else: sgit("remote", "add", "origin", remote)
    print("state backup set up: %s -> %s" % (STATE, remote))


def backup_now(msg, quiet=False):
    """Commit every tracked-able change under state/ and push. Serialised with a lock file."""
    import fcntl
    with open(os.path.join(STATE, ".backup.lock"), "a+") as lf:
        fcntl.flock(lf, fcntl.LOCK_EX)
        sgit("add", "-A")
        if sgit("status", "--porcelain", check=False):
            sgit("commit", "-q", "-m", msg)
        has_up = sgit("rev-parse", "--abbrev-ref", "@{upstream}", check=False)
        if has_up:
            sgit("pull", "--rebase", "-q", check=False)
            if sgit("rev-list", "--count", "@{upstream}..HEAD", check=False) not in ("", "0"):
                sgit("push", "-q")
        elif sgit("rev-parse", "-q", "--verify", "HEAD", check=False):
            sgit("push", "-q", "-u", "origin", "main")
    if not quiet: print("state backed up (%s)" % sgit("log", "-1", "--format=%h %ci"))


def backup_running():
    import fcntl
    try:
        with open(os.path.join(STATE, ".backup.lock"), "a+") as lf:
            fcntl.flock(lf, fcntl.LOCK_EX | fcntl.LOCK_NB); fcntl.flock(lf, fcntl.LOCK_UN)
        return False
    except OSError:
        return True


def auto_backup(what):
    """After a ledger/lesson/rule change: back up in a detached process so the CLI returns at once."""
    if not backup_ready(): return
    subprocess.Popen([sys.executable, os.path.realpath(__file__), "backup", "--quiet", "--message", "auto: " + what],
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=open(os.path.join(STATE, "backup.err"), "a"),
                     env={**os.environ, "T3_LEAD_HOME": ROOT}, start_new_session=True)


def cmd_backup(a):
    if "--init" in a: backup_init(); a = [x for x in a if x != "--init"]
    if "--status" in a:
        if not backup_ready(): print("state backup: not set up (state_remote in config.json, then `t3lead backup --init`)"); return
        last = sgit("log", "-1", "--format=%h %ci", check=False) or "no commits yet"
        dirty = len([l for l in sgit("status", "--porcelain", check=False).splitlines() if l])
        ahead = sgit("rev-list", "--count", "@{upstream}..HEAD", check=False) or "?"
        busy = backup_running()
        print("state backup: last %s; %d uncommitted change(s); %s unpushed commit(s)%s -> %s" % (
            last, dirty, ahead, " (a background backup is running now)" if busy else "", CFG["state_remote"])); return
    if not backup_ready(): die("state backup is not set up (state_remote in config.json, then `t3lead backup --init`)")
    msg = opt(a, "--message", "backup " + now())
    try:
        backup_now(msg, quiet="--quiet" in a)
    except RuntimeError as e:
        die("backup failed: %s%s" % (e, auth_hint(str(e), STATE)))


def save(t):
    os.makedirs(TASKS, exist_ok=True)
    p = os.path.join(TASKS, t["id"] + ".json"); tmp = p + ".tmp"
    with open(tmp, "w") as f: json.dump(t, f, ensure_ascii=False, indent=1)
    os.replace(tmp, p)


def load(tid):
    p = os.path.join(TASKS, tid + ".json")
    if not os.path.exists(p): die(f"request {tid} not found")
    return json.load(open(p))


def all_tasks():
    if not os.path.isdir(TASKS): return []
    out = [json.load(open(os.path.join(TASKS, f))) for f in sorted(os.listdir(TASKS)) if f.endswith(".json")]
    return sorted(out, key=lambda t: t["created"])


def check_where(name):
    """Return the value to store for --where: None clears it; an unknown name is accepted with a warning."""
    if name == "-": return None
    known = CFG["remotes"]
    if name not in known:
        print("warning: %r is not in config.json remotes (%s)" % (name, ", ".join(known) or "none configured"), file=sys.stderr)
    return name


def at(t):
    return "@%s " % t["where"] if t.get("where") else ""


def cmd_task(a):
    if not a: die("task add|move|list|show")
    sub, a = a[0], a[1:]
    if sub == "add":
        src = opt(a, "--source", "chat"); where = opt(a, "--where")
        if not a: die("give the request text")
        t = {"id": "t-" + secrets.token_hex(2), "text": " ".join(a), "source": src, "state": "open",
             "created": now(), "verifier": None, "history": [[now(), "open", ""]]}
        if where: t["where"] = check_where(where)
        save(t); print(t["id"]); auto_backup("task add " + t["id"])
    elif sub == "move":
        note = opt(a, "--note", ""); ver = opt(a, "--verifier"); where = opt(a, "--where")
        if len(a) != 2 or a[1] not in STATES: die(f"task move <id> <{'|'.join(STATES)}>")
        t = load(a[0]); t["state"] = a[1]
        if ver: t["verifier"] = ver
        if where:
            w = check_where(where)
            if w: t["where"] = w
            else: t.pop("where", None)
        t["history"].append([now(), a[1], note]); save(t); print(f"{t['id']} -> {a[1]}"); auto_backup("task %s -> %s" % (t["id"], a[1]))
    elif sub == "list":
        show_all = "--all" in a
        for t in all_tasks():
            if show_all or t["state"] in OPEN:
                print(f"{t['id']}  {t['state']:<13} {t['created'][5:16]}  {at(t)}{t['text'][:60]}")
    elif sub == "show":
        print(json.dumps(load(a[0]), ensure_ascii=False, indent=1))
    else:
        die("task add|move|list|show")


def rule_sets():
    return t3lead_config.owner_rule_sets(CFG)


def write_rule_file(path, rs):
    os.makedirs(os.path.dirname(path), exist_ok=True); tmp = path + ".tmp"
    with open(tmp, "w") as f: f.write("".join("- %s\n" % r for r in rs))
    os.replace(tmp, path)


def shared_git(*args, check=True):
    r = subprocess.run(["git", "-C", CFG["owner_rules_dir"], *args], capture_output=True, text=True)
    if check and r.returncode != 0:
        raise RuntimeError("git %s: %s" % (" ".join(args), (r.stderr or r.stdout).strip()))
    return r.stdout.strip()


def shared_sync(quiet=False):
    """Pull the shared rules (rebase local commits) and push anything not yet pushed. Returns True on success."""
    try:
        shared_git("pull", "--rebase", "--quiet")
        ahead = shared_git("rev-list", "--count", "@{upstream}..HEAD", check=False)
        if ahead and ahead != "0": shared_git("push", "--quiet")
        if not quiet: print("shared rules synced (%s)" % shared_git("log", "-1", "--format=%h %cs"))
        return True
    except RuntimeError as e:
        print("warning: shared rules not synced: %s\n  the change is kept locally; run `t3lead rule sync` later%s"
              % (e, auth_hint(str(e), CFG["owner_rules_dir"])), file=sys.stderr)
        return False


def shared_commit(path, msg):
    try:
        shared_git("add", os.path.basename(path)); shared_git("commit", "--quiet", "-m", msg)
    except RuntimeError as e:
        print("warning: %s" % e, file=sys.stderr); return
    shared_sync(quiet=True)


def cmd_rule(a):
    sub = a[0] if a else "list"
    sets = rule_sets()
    if sub == "add":
        shared = "--shared" in a
        a = [x for x in a if x != "--shared"]
        text = " ".join(a[1:]).strip()
        if not text: die("give the rule text")
        if "\n" in text: die("one line per rule")
        if shared and not CFG["owner_rules_dir"]: die("no owner_rules_dir in config.json; shared rules are not set up")
        label, prefix, path, rs = sets[0] if shared else sets[-1]
        if shared: shared_sync(quiet=True)
        rs = t3lead_config.read_rule_file(path)
        rs.append("%s (%s)" % (text, now()[:10])); write_rule_file(path, rs)
        if shared: shared_commit(path, "Add rule: " + text[:60])
        print("rule %s%d added (%s)" % (prefix, len(rs), label))
        if prefix == "L": auto_backup("rule add")
    elif sub == "list":
        for label, prefix, path, rs in sets:
            print("%s  [%s]" % (label, path))
            if not rs: print("  (none)")
            for n, r in enumerate(rs, 1): print("  %s%d. %s" % (prefix, n, r))
        if not CFG["owner_rules_dir"]:
            print("(shared rules not set up: set owner_rules_dir in config.json)")
    elif sub == "rm":
        if len(a) != 2: die("rule rm <S<n>|L<n>> (from rule list)")
        key = a[1].upper()
        if key.isdigit(): key = "L" + key
        match = [x for x in sets if x[1] == key[0]]
        if not match or not key[1:].isdigit(): die("rule rm <S<n>|L<n>> (from rule list)")
        label, prefix, path, rs = match[0]
        if prefix == "S": shared_sync(quiet=True); rs = t3lead_config.read_rule_file(path)
        n = int(key[1:])
        if not 1 <= n <= len(rs): die("no rule %s" % key)
        r = rs.pop(n - 1); write_rule_file(path, rs)
        if prefix == "S": shared_commit(path, "Remove rule: " + r[:60])
        print("removed (%s): %s" % (label, r))
        if prefix == "L": auto_backup("rule rm")
    elif sub == "sync":
        if not CFG["owner_rules_dir"]: die("no owner_rules_dir in config.json; shared rules are not set up")
        shared_sync()
    else:
        die("rule add [--shared]|list|rm|sync")


def cmd_heavy(a):
    groups = CFG["heavy_groups"]
    if not a or a[0] == "status":
        t3lead_heavy.status(STATE, groups); return
    if "--" not in a: die("heavy --group G [--label L] [--max-wait SECONDS] -- <command ...> | heavy status")
    i = a.index("--"); opts, cmd = a[:i], a[i + 1:]
    group = opt(opts, "--group"); label = opt(opts, "--label"); mw = opt(opts, "--max-wait")
    if opts: die("unknown heavy option(s): %s" % " ".join(opts))
    if not group: die("give --group (configured: %s)" % (", ".join(sorted(groups)) or "none"))
    try: mw = float(mw) if mw is not None else None
    except ValueError: die("--max-wait takes seconds")
    sys.exit(t3lead_heavy.run(STATE, groups, group, cmd, label=label, max_wait=mw,
                              max_load=CFG["heavy_max_load"], alert_min=CFG["heavy_wait_alert_min"]))


def cmd_learn(a):
    kind = opt(a, "--kind", "general")
    if not a: die("give a one-line lesson")
    os.makedirs(STATE, exist_ok=True)
    with open(LESSONS, "a") as f:
        f.write(json.dumps({"at": now(), "kind": kind, "text": " ".join(a)}, ensure_ascii=False) + "\n")
    print("recorded"); auto_backup("lesson")


def lessons(kind=None):
    if not os.path.exists(LESSONS): return []
    out = [json.loads(l) for l in open(LESSONS) if l.strip()]
    return [x for x in out if not kind or x["kind"] in (kind, "general")]


def cmd_status(_):
    ts = all_tasks()
    opn = [t for t in ts if t["state"] in OPEN]
    first = [t for t in opn if t["state"] in ("waiting-owner", "delivered")]
    print(f"requests: {len(opn)} open / {len(ts)} total")
    waits = t3lead_heavy.long_waits(STATE, CFG["heavy_groups"], CFG["heavy_wait_alert_min"]) if CFG["heavy_groups"] else []
    if waits:
        print("heavy queue: %d long wait(s) (`t3lead heavy status`):" % len(waits))
        for g, e, m in waits:
            print("  %s waiting %d min: %s" % (g, m, t3lead_heavy.describe(e)))
    if first:
        print("look at first:")
        for t in first:
            why = "needs the user's answer" if t["state"] == "waiting-owner" else "finished but not yet reported"
            print(f"  {t['id']} {why}: {at(t)}{t['text'][:50]}")
    for t in opn:
        if t not in first:
            last = t["history"][-1]
            print(f"  {t['id']} {t['state']} (last {last[0][5:16]}{' ' + last[2][:30] if last[2] else ''}): {at(t)}{t['text'][:45]}")
    if CFG["state_remote"]:
        if not backup_ready(): print("state backup: configured but not initialised (`t3lead backup --init`)")
        else:
            pend = sgit("rev-list", "--count", "@{upstream}..HEAD", check=False)
            if (pend not in ("", "0") or not sgit("rev-parse", "--abbrev-ref", "@{upstream}", check=False)) and not backup_running():
                print("state backup: not pushed yet; run `t3lead backup` (see state/backup.err)")
    n_rules = sum(len(x[3]) for x in rule_sets())
    if n_rules:
        print(f"owner rules: {n_rules} (`t3lead rule list`)")
    ls = lessons()
    if ls:
        print(f"lessons: {len(ls)} (latest 3):")
        for x in ls[-3:]: print(f"  [{x['kind']}] {x['text'][:70]}")


def cmd_models(_):
    m = CFG["models"]
    rows = [("lead", m["lead"]), ("verifier", m["verifier"])]
    rows += [("gpt lane #%d%s" % (n + 1, " (default)" if n == 0 else ""), x) for n, x in enumerate(m["gpt_lanes"])]
    rows += [("gpt lane (refusal-prone)", m["gpt_lane_refusal_prone"]), ("claude lane", m["claude_lane"]),
             ("light lane", m["light_lane"])]
    w = max(len(r[0]) for r in rows)
    for name, x in rows:
        print(f"{name:<{w}}  {x['instance']} / {x['model']}")
    for name, r in CFG["remotes"].items():
        mm = r["models"]
        rr = [("gpt lane #%d%s" % (n + 1, " (default)" if n == 0 else ""), x) for n, x in enumerate(mm["gpt_lanes"])]
        rr += [("gpt lane (refusal-prone)", mm["gpt_lane_refusal_prone"]), ("claude lane", mm["claude_lane"]),
               ("light lane", mm["light_lane"])]
        print(f"\nremote {name}" + (f" ({r['label']})" if r["label"] else "") + ":")
        for (label, x), key in zip(rr, ["gpt_lanes"] * len(mm["gpt_lanes"]) + ["gpt_lane_refusal_prone", "claude_lane", "light_lane"]):
            note = "" if key in r["own_models"] else "  (same as local)"
            print(f"  {label:<{w}}  {x['instance']} / {x['model']}{note}")
    print(f"(config: {CFG['config_path'] if CFG['config_found'] else 'none, built-in defaults'})")


def cmd_remotes(_):
    if not CFG["remotes"]:
        print("no remote computers configured (add \"remotes\" to %s)" % CFG["config_path"]); return
    for name, r in CFG["remotes"].items():
        print(f"{name}" + (f"  ({r['label']})" if r["label"] else ""))
        print(f"  environmentId  {r['environmentId']}")
        print(f"  projectId      {r['projectId']}")
        print("  models         " + (("own: " + ", ".join(r["own_models"]) + "; rest same as local") if r["own_models"] else "same as local (set models in the remote entry if its instance names differ)"))


def cmd_init(_):
    tid = os.environ.get("T3CODE_THREAD_ID")
    if not tid: die("T3CODE_THREAD_ID is not set. Run this inside a T3 thread")
    out = subprocess.run([sys.executable, os.path.join(t3lead_config.CODE_DIR, "hooks", "role.py"), "--register-lead", tid],
                         env={**os.environ, "T3_LEAD_HOME": ROOT}, capture_output=True, text=True)
    print(out.stdout.strip() or out.stderr.strip())


def git(*args, check=True):
    r = subprocess.run(["git", "-C", t3lead_config.CODE_DIR, *args], capture_output=True, text=True)
    if check and r.returncode != 0:
        die("git %s failed: %s" % (" ".join(args), (r.stderr or r.stdout).strip()))
    return r.stdout.strip()


def fetch():
    git("fetch", "--quiet", "--tags", "--force", "origin")


def upstream_ref():
    return git("rev-parse", "--abbrev-ref", "@{upstream}", check=False) or "origin/main"


def latest_release():
    """Newest vX.Y.Z tag that is reachable from the upstream branch, or None."""
    tags = [t for t in git("tag", "--list", "v[0-9]*", "--merged", upstream_ref(), "--sort=-v:refname").splitlines() if t]
    return tags[0] if tags else None


def commits(rev_range):
    return [l for l in git("log", "--oneline", rev_range).splitlines() if l]


def is_ancestor(a, b):
    return subprocess.run(["git", "-C", t3lead_config.CODE_DIR, "merge-base", "--is-ancestor", a, b]).returncode == 0


def target(edge):
    """(ref, label) to upgrade to: the latest release tag, or the upstream branch with --edge / when there is no tag."""
    up = upstream_ref()
    if edge:
        return up, up
    rel = latest_release()
    return (rel, "release " + rel) if rel else (up, up + " (no release tag yet)")


def cmd_version(_):
    fetch()
    desc = git("describe", "--tags", "--always", "--match", "v[0-9]*", check=False)
    print("installed: %s  (%s)" % (desc, git("log", "-1", "--format=%h %cs %s")))
    rel, up = latest_release(), upstream_ref()
    if rel:
        new = commits("HEAD.." + rel)
        if new: print("latest release %s: %d commit(s) newer; run `t3lead upgrade`" % (rel, len(new)))
        elif is_ancestor(rel, "HEAD") and commits(rel + "..HEAD"): print("latest release %s: you are ahead of it (edge)" % rel)
        else: print("latest release %s: up to date" % rel)
    else:
        print("no release tag yet")
    edge = commits("HEAD.." + up)
    print("%s: %s" % (up, "%d commit(s) newer; `t3lead upgrade --edge` takes them" % len(edge) if edge else "up to date"))


def cmd_upgrade(a):
    old = git("rev-parse", "--short", "HEAD")
    fetch()
    ref, label = target("--edge" in a)
    new = commits("HEAD.." + ref)
    if not new:
        ahead = "" if is_ancestor("HEAD", ref) else "; you are ahead of it (use --edge to follow the branch)"
        print("already up to date with %s (%s)%s" % (label, old, ahead)); return
    print("new commits in %s:" % label)
    for l in reversed(new): print("  " + l)
    if "--check" in a: return
    dirty = [l for l in git("status", "--porcelain", "--untracked-files=no").splitlines() if l]
    if dirty:
        die("local changes in %s; commit or discard them first:\n%s" % (t3lead_config.CODE_DIR, "\n".join(dirty)))
    r = subprocess.run(["git", "-C", t3lead_config.CODE_DIR, "merge", "--ff-only", "--quiet", ref], capture_output=True, text=True)
    if r.returncode != 0:
        die("cannot fast-forward to %s (local commits?): %s" % (label, (r.stderr or r.stdout).strip()))
    print("updated %s -> %s (%s); re-running install.sh" % (old, git("rev-parse", "--short", "HEAD"), label), flush=True)
    quiet = "--quiet" in a
    r = subprocess.run(["bash", os.path.join(t3lead_config.CODE_DIR, "install.sh")], env={**os.environ, "T3_LEAD_HOME": ROOT},
                       capture_output=quiet, text=True)
    if quiet:
        lines = (r.stdout + r.stderr).splitlines()
        keep = [l for l in lines if any(k in l for k in ("WARNING", "SKIPPED", "differs", "failed", "error", "not found",
                                                             " added", " patched", " linked:", " registered", " set ")) and "already" not in l]
        print("install.sh: %d line(s) of output, %d worth reading:" % (len(lines), len(keep)))
        for l in keep: print("  " + l.strip())
    if r.returncode != 0: die("install.sh failed (exit %d); the code is updated, fix the error and re-run install.sh" % r.returncode)
    print("done. Verifier/lane rules apply from the next prompt. Lead: re-read the t3-lead skill now; "
          "hook or wrapper changes apply to sessions started after this.")


def main():
    a = sys.argv[1:]
    if not a or a[0] in ("-h", "--help"): print(__doc__); return
    {"task": cmd_task, "rule": cmd_rule, "heavy": cmd_heavy, "backup": cmd_backup, "learn": cmd_learn, "status": cmd_status, "init": cmd_init, "models": cmd_models, "remotes": cmd_remotes,
     "version": cmd_version, "upgrade": cmd_upgrade,
     "lessons": lambda r: [print(f"[{x['kind']}] {x['text']}") for x in lessons(opt(r, "--kind"))]
     }.get(a[0], lambda _: die(__doc__))(a[1:])


if __name__ == "__main__":
    main()
