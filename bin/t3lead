#!/usr/bin/env python3
"""t3-lead state CLI: lead registration, request ledger, lessons, summary.

  t3lead init                          register this thread (T3CODE_THREAD_ID) as the lead
  t3lead task add "<request>" [--source S] [--where REMOTE]   record a request, print its ID
  t3lead task move <id> <state> [--note N] [--verifier THREAD] [--where REMOTE]
        states: open working waiting-owner delivered done dropped
        --where: which remote computer runs the lanes (a name from `t3lead remotes`); `--where -` clears it
  t3lead task list [--all]             unfinished requests (default) / all requests
  t3lead task show <id>
  t3lead learn "<one-line lesson>" [--kind K]
  t3lead lessons [--kind K]
  t3lead status                        ~20-line summary for the lead to read after a restart
  t3lead models                        provider instance / model per role, from config.json (or defaults);
                                       one block per configured remote computer
  t3lead remotes                       remote computers (T3 linked environments) from config.json
  t3lead version                       installed commit, and whether origin has newer commits
  t3lead upgrade [--check]             pull the latest t3-lead (fast-forward only) and re-run install.sh;
                                       --check only lists the new commits
"""
import json, os, secrets, subprocess, sys, time

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "lib"))
import t3lead_config

try:
    CFG = t3lead_config.load()
except t3lead_config.ConfigError as e:
    print("t3lead config error: %s" % e, file=sys.stderr); sys.exit(2)
ROOT = CFG["home"]
STATE = os.path.join(ROOT, "state")
TASKS = os.path.join(STATE, "tasks")
LESSONS = os.path.join(STATE, "lessons.jsonl")
STATES = ["open", "working", "waiting-owner", "delivered", "done", "dropped"]
OPEN = {"open", "working", "waiting-owner", "delivered"}

now = lambda: time.strftime("%Y-%m-%dT%H:%M:%S")


def die(msg):
    print(msg, file=sys.stderr); sys.exit(2)


def opt(args, name, default=None):
    if name in args:
        i = args.index(name)
        if i + 1 >= len(args): die(f"missing value for {name}")
        v = args[i + 1]; del args[i:i + 2]; return v
    return default


def save(t):
    os.makedirs(TASKS, exist_ok=True)
    p = os.path.join(TASKS, t["id"] + ".json"); tmp = p + ".tmp"
    with open(tmp, "w") as f: json.dump(t, f, ensure_ascii=False, indent=1)
    os.replace(tmp, p)


def load(tid):
    p = os.path.join(TASKS, tid + ".json")
    if not os.path.exists(p): die(f"request {tid} not found")
    return json.load(open(p))


def all_tasks():
    if not os.path.isdir(TASKS): return []
    out = [json.load(open(os.path.join(TASKS, f))) for f in sorted(os.listdir(TASKS)) if f.endswith(".json")]
    return sorted(out, key=lambda t: t["created"])


def check_where(name):
    """Return the value to store for --where: None clears it; an unknown name is accepted with a warning."""
    if name == "-": return None
    known = CFG["remotes"]
    if name not in known:
        print("warning: %r is not in config.json remotes (%s)" % (name, ", ".join(known) or "none configured"), file=sys.stderr)
    return name


def at(t):
    return "@%s " % t["where"] if t.get("where") else ""


def cmd_task(a):
    if not a: die("task add|move|list|show")
    sub, a = a[0], a[1:]
    if sub == "add":
        src = opt(a, "--source", "chat"); where = opt(a, "--where")
        if not a: die("give the request text")
        t = {"id": "t-" + secrets.token_hex(2), "text": " ".join(a), "source": src, "state": "open",
             "created": now(), "verifier": None, "history": [[now(), "open", ""]]}
        if where: t["where"] = check_where(where)
        save(t); print(t["id"])
    elif sub == "move":
        note = opt(a, "--note", ""); ver = opt(a, "--verifier"); where = opt(a, "--where")
        if len(a) != 2 or a[1] not in STATES: die(f"task move <id> <{'|'.join(STATES)}>")
        t = load(a[0]); t["state"] = a[1]
        if ver: t["verifier"] = ver
        if where:
            w = check_where(where)
            if w: t["where"] = w
            else: t.pop("where", None)
        t["history"].append([now(), a[1], note]); save(t); print(f"{t['id']} -> {a[1]}")
    elif sub == "list":
        show_all = "--all" in a
        for t in all_tasks():
            if show_all or t["state"] in OPEN:
                print(f"{t['id']}  {t['state']:<13} {t['created'][5:16]}  {at(t)}{t['text'][:60]}")
    elif sub == "show":
        print(json.dumps(load(a[0]), ensure_ascii=False, indent=1))
    else:
        die("task add|move|list|show")


def cmd_learn(a):
    kind = opt(a, "--kind", "general")
    if not a: die("give a one-line lesson")
    os.makedirs(STATE, exist_ok=True)
    with open(LESSONS, "a") as f:
        f.write(json.dumps({"at": now(), "kind": kind, "text": " ".join(a)}, ensure_ascii=False) + "\n")
    print("recorded")


def lessons(kind=None):
    if not os.path.exists(LESSONS): return []
    out = [json.loads(l) for l in open(LESSONS) if l.strip()]
    return [x for x in out if not kind or x["kind"] in (kind, "general")]


def cmd_status(_):
    ts = all_tasks()
    opn = [t for t in ts if t["state"] in OPEN]
    first = [t for t in opn if t["state"] in ("waiting-owner", "delivered")]
    print(f"requests: {len(opn)} open / {len(ts)} total")
    if first:
        print("look at first:")
        for t in first:
            why = "needs the user's answer" if t["state"] == "waiting-owner" else "finished but not yet reported"
            print(f"  {t['id']} {why}: {at(t)}{t['text'][:50]}")
    for t in opn:
        if t not in first:
            last = t["history"][-1]
            print(f"  {t['id']} {t['state']} (last {last[0][5:16]}{' ' + last[2][:30] if last[2] else ''}): {at(t)}{t['text'][:45]}")
    ls = lessons()
    if ls:
        print(f"lessons: {len(ls)} (latest 3):")
        for x in ls[-3:]: print(f"  [{x['kind']}] {x['text'][:70]}")


def cmd_models(_):
    m = CFG["models"]
    rows = [("lead", m["lead"]), ("verifier", m["verifier"])]
    rows += [("gpt lane #%d%s" % (n + 1, " (default)" if n == 0 else ""), x) for n, x in enumerate(m["gpt_lanes"])]
    rows += [("gpt lane (refusal-prone)", m["gpt_lane_refusal_prone"]), ("claude lane", m["claude_lane"]),
             ("light lane", m["light_lane"])]
    w = max(len(r[0]) for r in rows)
    for name, x in rows:
        print(f"{name:<{w}}  {x['instance']} / {x['model']}")
    for name, r in CFG["remotes"].items():
        mm = r["models"]
        rr = [("gpt lane #%d%s" % (n + 1, " (default)" if n == 0 else ""), x) for n, x in enumerate(mm["gpt_lanes"])]
        rr += [("gpt lane (refusal-prone)", mm["gpt_lane_refusal_prone"]), ("claude lane", mm["claude_lane"]),
               ("light lane", mm["light_lane"])]
        print(f"\nremote {name}" + (f" ({r['label']})" if r["label"] else "") + ":")
        for (label, x), key in zip(rr, ["gpt_lanes"] * len(mm["gpt_lanes"]) + ["gpt_lane_refusal_prone", "claude_lane", "light_lane"]):
            note = "" if key in r["own_models"] else "  (same as local)"
            print(f"  {label:<{w}}  {x['instance']} / {x['model']}{note}")
    print(f"(config: {CFG['config_path'] if CFG['config_found'] else 'none, built-in defaults'})")


def cmd_remotes(_):
    if not CFG["remotes"]:
        print("no remote computers configured (add \"remotes\" to %s)" % CFG["config_path"]); return
    for name, r in CFG["remotes"].items():
        print(f"{name}" + (f"  ({r['label']})" if r["label"] else ""))
        print(f"  environmentId  {r['environmentId']}")
        print(f"  projectId      {r['projectId']}")
        print("  models         " + (("own: " + ", ".join(r["own_models"]) + "; rest same as local") if r["own_models"] else "same as local (set models in the remote entry if its instance names differ)"))


def cmd_init(_):
    tid = os.environ.get("T3CODE_THREAD_ID")
    if not tid: die("T3CODE_THREAD_ID is not set. Run this inside a T3 thread")
    out = subprocess.run([sys.executable, os.path.join(t3lead_config.CODE_DIR, "hooks", "role.py"), "--register-lead", tid],
                         env={**os.environ, "T3_LEAD_HOME": ROOT}, capture_output=True, text=True)
    print(out.stdout.strip() or out.stderr.strip())


def git(*args, check=True):
    r = subprocess.run(["git", "-C", t3lead_config.CODE_DIR, *args], capture_output=True, text=True)
    if check and r.returncode != 0:
        die("git %s failed: %s" % (" ".join(args), (r.stderr or r.stdout).strip()))
    return r.stdout.strip()


def pending_commits(fetch=True):
    if fetch:
        git("fetch", "--quiet", "origin")
    upstream = git("rev-parse", "--abbrev-ref", "@{upstream}", check=False) or "origin/main"
    return upstream, [l for l in git("log", "--oneline", "HEAD.." + upstream).splitlines() if l]


def cmd_version(_):
    head = git("log", "-1", "--format=%h %cs %s")
    print("installed: " + head)
    upstream, new = pending_commits()
    print("up to date with %s" % upstream if not new else "%d newer commit(s) on %s; run `t3lead upgrade`" % (len(new), upstream))


def cmd_upgrade(a):
    dirty = [l for l in git("status", "--porcelain", "--untracked-files=no").splitlines() if l]
    if dirty:
        die("local changes in %s; commit or discard them first:\n%s" % (t3lead_config.CODE_DIR, "\n".join(dirty)))
    old = git("rev-parse", "--short", "HEAD")
    upstream, new = pending_commits()
    if not new:
        print("already up to date (%s)" % old); return
    print("new commits on %s:" % upstream)
    for l in reversed(new): print("  " + l)
    if "--check" in a: return
    git("merge", "--ff-only", "--quiet", upstream)
    print("updated %s -> %s; re-running install.sh" % (old, git("rev-parse", "--short", "HEAD")), flush=True)
    r = subprocess.run(["bash", os.path.join(t3lead_config.CODE_DIR, "install.sh")], env={**os.environ, "T3_LEAD_HOME": ROOT})
    if r.returncode != 0: die("install.sh failed (exit %d); the code is updated, fix the error and re-run install.sh" % r.returncode)
    print("done. Verifier/lane rules apply from the next prompt. Lead: re-read the t3-lead skill now; "
          "hook or wrapper changes apply to sessions started after this.")


def main():
    a = sys.argv[1:]
    if not a or a[0] in ("-h", "--help"): print(__doc__); return
    {"task": cmd_task, "learn": cmd_learn, "status": cmd_status, "init": cmd_init, "models": cmd_models, "remotes": cmd_remotes,
     "version": cmd_version, "upgrade": cmd_upgrade,
     "lessons": lambda r: [print(f"[{x['kind']}] {x['text']}") for x in lessons(opt(r, "--kind"))]
     }.get(a[0], lambda _: die(__doc__))(a[1:])


if __name__ == "__main__":
    main()
